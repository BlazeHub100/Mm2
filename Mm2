addToggle(InnocentTab, "AFK บนฟ้า (ยืนบนฟ้าไม่ตก)", false, function(v)
    SkyAFKEnabled = v
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if SkyAFKEnabled then
        if hrp then
            if not SkyPlatform then
                SkyPlatform = Instance.new("Part")
                SkyPlatform.Name = "BlazeAFKSkyPart"
                SkyPlatform.Size = Vector3.new(20, 1, 20)
                SkyPlatform.Anchored = true
                SkyPlatform.Transparency = 0.5
                SkyPlatform.Color = Color3.fromRGB(0, 170, 255)
                SkyPlatform.Material = Enum.Material.Neon
                SkyPlatform.Parent = Workspace
            end
            local skyPos = hrp.CFrame + Vector3.new(0, 250, 0)
            SkyPlatform.CFrame = skyPos - Vector3.new(0, 2, 0)
            hrp.CFrame = skyPos
        end
    else
        if SkyPlatform then
            SkyPlatform:Destroy()
            SkyPlatform = nil
        end
    end
end)

